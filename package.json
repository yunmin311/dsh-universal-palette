{
  "name": "@yunmin311/dsh-universal-palette",
  "version": "0.1.0",
  "description": "Dense translucent-glass Universal Palette for DeepSeek Harness Web — federates Commands, Models, Sessions, Conversation Hits with rich secondary actions and deterministic context/frecency ranking.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown -c tsdown.client.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-sessions",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-store"
      ],
      "external": []
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
